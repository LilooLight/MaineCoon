// Prisma schema for family Maine Coon cattery "Тихий Дом"
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Breeding cats — producers (males + females) + retired mascot
model Producer {
  id          String   @id @default(cuid())
  name        String
  role        String   // "male" | "female"
  color       String   // "black" | "tabby" | "silver" | "silver-red" | "black-smoke" | "black-tabby"
  colorLabel  String   // human readable
  birthDate   String
  imageUrl    String
  bio         String
  personality String   // calm / playful / independent / affectionate
  retired     Boolean  @default(false) // retired from breeding (e.g. mascot)
  registry    String   // родословная / registry number
  documents   String   // JSON array of document descriptions (pedigree, vet passport, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  littersAsFather Litter[] @relation("LitterFather")
  littersAsMother Litter[] @relation("LitterMother")
}

// Litter — 2-3 per year
model Litter {
  id          String    @id @default(cuid())
  name        String    // e.g. "Помёт «Лето 2024»"
  fatherId    String
  motherId    String
  father      Producer  @relation("LitterFather", fields: [fatherId], references: [id])
  mother      Producer  @relation("LitterMother", fields: [motherId], references: [id])
  bornAt      DateTime
  expected    Boolean   @default(false) // expected vs available
  notes       String
  kittens     Kitten[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Kittens for the catalog with character filter
model Kitten {
  id           String    @id @default(cuid())
  name         String
  color        String    // black | tabby | silver | silver-red
  colorLabel   String
  gender       String    // male | female
  personality  String    // calm | playful | independent | affectionate
  personalityLabel String
  litterId     String
  litter       Litter    @relation(fields: [litterId], references: [id])
  birthDate    DateTime
  imageUrl     String
  videoUrl     String?   // optional behavior video (mp4)
  status       String    @default("available") // available | reserved | adopted | expected
  statusLabel  String
  price        Int
  description  String
  vaccinated   Boolean   @default(false)
  documented   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Reviews — "graduates" with full case history
model Review {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String   // e.g. "Семья с двумя детьми", "Удалённый дизайнер"
  kittenName  String
  kittenColor String
  adoptedAt   String   // e.g. "Осень 2023"
  rating      Int      @default(5)
  text        String
  imageUrl    String?
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Blog posts for SEO
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String   // e.g. "Здоровье", "Характер", "Уход", "Выбор"
  readMinutes Int      @default(5)
  imageUrl    String
  views       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Booking — online reservation (the differentiator competitors lack)
model Booking {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  kittenId    String?  // nullable — waiting list without a specific kitten
  kittenName  String?
  message     String
  type        String   @default("booking") // booking | waiting-list
  status      String   @default("new") // new | contacted | confirmed | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ContactMessage — visit planning + general inquiries
model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  preferredDates String   @default("") // JSON array of ISO date strings
  contactChannel String   @default("phone") // phone | email | telegram | vk
  contactValue   String   // phone number / email / @nickname / VK profile URL
  comment        String   @default("") // optional, max 500 chars
  status         String   @default("new") // new | read | replied | closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
